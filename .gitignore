# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local configuration and secrets. The app takes API_BASE_URL and
# USE_MOCK_DATA via --dart-define, but keep these out if they ever appear.
.env
.env.*
!.env.example
*.pem

# Backend (Python)
backend/.venv/
__pycache__/
.pytest_cache/
